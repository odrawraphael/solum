import type { ReactNode } from "react";
import { cn } from "@/lib/utils";

export function ControlRow({
  title,
  hint,
  value,
  min,
  max,
  step,
  onChange,
}: {
  title: string;
  hint?: string;
  value: number;
  min: number;
  max: number;
  step: number;
  onChange: (v: number) => void;
}) {
  const set = (raw: string) => {
    const v = Number(raw);
    if (!Number.isFinite(v)) return;
    onChange(Math.max(min, Math.min(max, v)));
  };
  return (
    <div className="grid grid-cols-[minmax(0,1fr)_minmax(64px,92px)_52px] items-center gap-2 py-0.5 max-[360px]:grid-cols-[minmax(0,1fr)_52px]">
      <div className="min-w-0">
        <div className="text-xs font-medium leading-tight">{title}</div>
        {hint ? <div className="text-[10px] leading-tight text-muted">{hint}</div> : null}
      </div>
      <input
        type="range"
        min={min}
        max={max}
        step={step}
        value={value}
        onChange={(e) => set(e.target.value)}
        className="h-8 w-full min-w-0 max-[360px]:hidden"
        aria-label={title}
      />
      <input
        type="number"
        min={min}
        max={max}
        step={step}
        value={Number.isInteger(step) ? value : Number(value.toFixed(3))}
        onChange={(e) => set(e.target.value)}
        className="h-7 w-full rounded-sm border border-line bg-panel-2 px-1 text-right font-mono text-[11px] tabular-nums text-fg outline-none focus:border-accent"
      />
    </div>
  );
}

export function Section({
  title,
  open = true,
  children,
}: {
  title: string;
  open?: boolean;
  children: ReactNode;
}) {
  return (
    <details open={open} className="border-t border-line py-2">
      <summary className="cursor-pointer list-none font-display text-[13px] font-semibold text-accent [&::-webkit-details-marker]:hidden">
        <span className="mr-1.5 text-muted">▸</span>
        {title}
      </summary>
      <div className="pt-2">{children}</div>
    </details>
  );
}

export function FieldCard({
  selected,
  onClick,
  children,
}: {
  selected?: boolean;
  onClick?: () => void;
  children: ReactNode;
}) {
  return (
    <div
      onClick={onClick}
      className={cn(
        "mb-2 rounded-md border bg-panel-2 p-2",
        selected ? "border-accent shadow-[inset_0_0_0_1px_#a95032]" : "border-line",
      )}
    >
      {children}
    </div>
  );
}

export function MiniNum({
  label,
  value,
  step = 0.01,
  onChange,
}: {
  label: string;
  value: number;
  step?: number;
  onChange: (v: number) => void;
}) {
  return (
    <label className="grid gap-0.5 text-[10px] text-muted">
      {label}
      <input
        type="number"
        step={step}
        value={value}
        onChange={(e) => onChange(Number(e.target.value))}
        className="h-7 w-full min-w-0 rounded-sm border border-line bg-bg px-1 font-mono text-[11px] text-fg outline-none focus:border-accent"
      />
    </label>
  );
}

export function Pill({ children }: { children: ReactNode }) {
  return (
    <span className="inline-flex items-center gap-1 rounded-full border border-line bg-bg/80 px-2 py-0.5 text-[11px] text-muted backdrop-blur-sm">
      {children}
    </span>
  );
}
