import { useEffect, useRef } from "react";
import { Download, FolderOpen, FileJson, Undo2, Redo2 } from "lucide-react";
import { Button } from "@/components/ui/button";
import { migrateIncoming } from "@/lib/solum/schema";
import { buildPython } from "@/lib/solum/python";
import { useSolum } from "@/store/solum-store";
import { PreviewCanvas } from "./preview-canvas";
import { Sidebar } from "./sidebar";
import { Diagnostics } from "./diagnostics";

function download(name: string, text: string, mime: string) {
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([text], { type: mime }));
  a.download = name;
  a.click();
}

export function AppShell() {
  const fileRef = useRef<HTMLInputElement>(null);
  const reset = useSolum((s) => s.reset);
  const replace = useSolum((s) => s.replace);
  const setStatus = useSolum((s) => s.setStatus);
  const setDiagTab = useSolum((s) => s.setDiagTab);
  const hydrate = useSolum((s) => s.hydrate);
  const undo = useSolum((s) => s.undo);
  const redo = useSolum((s) => s.redo);
  const setPlaying = useSolum((s) => s.setPlaying);

  useEffect(() => {
    hydrate();
  }, [hydrate]);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      const t = e.target as HTMLElement | null;
      const typing = t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable);
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "z") {
        e.preventDefault();
        if (e.shiftKey) redo();
        else undo();
        return;
      }
      if (typing) return;
      if (e.key === " ") {
        e.preventDefault();
        setPlaying(!useSolum.getState().playing);
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [undo, redo, setPlaying]);

  return (
    <div className="flex h-dvh max-w-full flex-col overflow-hidden bg-bg text-fg max-md:h-auto max-md:overflow-x-hidden max-md:overflow-y-visible">
      <header className="flex flex-wrap items-center gap-1.5 border-b border-line bg-panel px-3 py-2">
        <Button onClick={reset}>Novo</Button>
        <Button onClick={undo} aria-label="Desfazer">
          <Undo2 /> Desfazer
        </Button>
        <Button onClick={redo} aria-label="Refazer">
          <Redo2 /> Refazer
        </Button>
        <Button
          onClick={() =>
            download("solum4_state.json", JSON.stringify(useSolum.getState().doc, null, 2), "application/json")
          }
        >
          <FileJson /> Salvar JSON
        </Button>
        <Button onClick={() => fileRef.current?.click()}>
          <FolderOpen /> Abrir JSON
        </Button>
        <Button
          variant="default"
          onClick={() => {
            const py = buildPython(useSolum.getState().doc);
            download("solum4_houdini.py", py, "text/x-python");
            setDiagTab("python");
            setStatus("Python gerado; nenhum processo externo foi executado.", "good");
          }}
        >
          <Download /> Gerar Python
        </Button>
        <input
          ref={fileRef}
          type="file"
          accept="application/json"
          className="hidden"
          onChange={(e) => {
            const f = e.target.files?.[0];
            if (!f) return;
            const r = new FileReader();
            r.onload = () => {
              try {
                const x = migrateIncoming(JSON.parse(String(r.result)));
                replace(x, "Estado carregado");
              } catch (err) {
                setStatus("JSON inválido: " + (err instanceof Error ? err.message : "erro"), "warn");
              }
            };
            r.readAsText(f);
          }}
        />
        <span className="ml-auto hidden text-[11px] text-muted sm:block">
          Preview instantâneo · Houdini só na exportação
        </span>
      </header>

      <div className="grid min-h-0 min-w-0 flex-1 grid-cols-[minmax(0,400px)_minmax(0,1fr)] max-md:grid-cols-1">
        <Sidebar />
        <main className="grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)] max-md:grid-rows-none">
          <PreviewCanvas />
          <Diagnostics />
        </main>
      </div>
    </div>
  );
}
