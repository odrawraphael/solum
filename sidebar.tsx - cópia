                name: `CORE ${s.sources.length + 1}`,
                kind: s.sources.length ? "subcore" : "core",
                radius: 0.22,
                x: 0.18 * s.sources.length,
              });
              s.sources.push(src);
              s.selected = { kind: "source", id: src.id };
            }, "Fonte adicionada")
          }
        >
          + fonte
        </Button>
      </div>
      {doc.sources.map((c) => (
        <SourceCard key={c.id} source={c} />
      ))}
    </div>
  );
}

function SourceCard({ source: c }: { source: Source }) {
  const sel = useSolum((s) => s.doc.selected);
  const patch = useSolum((s) => s.patch);
  const selected = sel.kind === "source" && sel.id === c.id;
  const set = (fn: (x: Source) => void) =>
    patch((s) => {
      const x = s.sources.find((n) => n.id === c.id);
      if (x) fn(x);
    });
  return (
    <FieldCard selected={selected} onClick={() => patch((s) => { s.selected = { kind: "source", id: c.id }; })}>
      <div className="flex items-center justify-between gap-2">
        <strong className="text-xs">{c.name}</strong>
        <small className="text-muted">{c.kind} · r {c.radius.toFixed(2)} · T {c.temperature.toFixed(1)}</small>
        <Button
          size="sm"
          variant="danger"
          onClick={(e) => {
            e.stopPropagation();
            patch((s) => {
              s.sources = s.sources.filter((n) => n.id !== c.id);
              s.selected = { kind: "object", id: "" };
            });
          }}
        >
          ×
        </Button>
      </div>
      <div className="mt-1.5 grid grid-cols-2 gap-1.5">
        <input value={c.name} onChange={(e) => set((x) => { x.name = e.target.value; })} className="h-7 rounded-sm border border-line bg-bg px-1.5 text-xs" />
        <select value={c.kind} onChange={(e) => set((x) => { x.kind = e.target.value as SourceKind; })} className="h-7 rounded-sm border border-line bg-bg px-1 text-xs">
          <option value="core">núcleo</option>
          <option value="subcore">subnúcleo</option>
          <option value="localized">emissão local</option>
          <option value="external">fonte externa</option>
        </select>
      </div>
      <div className="mt-1.5 grid grid-cols-4 gap-1.5">
        <MiniNum label="x" value={c.x} onChange={(v) => set((x) => { x.x = v; })} />
        <MiniNum label="y" value={c.y} onChange={(v) => set((x) => { x.y = v; })} />
        <MiniNum label="z" value={c.z} onChange={(v) => set((x) => { x.z = v; })} />
        <MiniNum label="raio" value={c.radius} onChange={(v) => set((x) => { x.radius = v; })} />
        <MiniNum label="temp" value={c.temperature} onChange={(v) => set((x) => { x.temperature = v; })} />
        <MiniNum label="emit" value={c.emission} onChange={(v) => set((x) => { x.emission = v; })} />
        <MiniNum label="abs" value={c.absorption} onChange={(v) => set((x) => { x.absorption = v; })} />
        <MiniNum label="falloff" value={c.falloff} onChange={(v) => set((x) => { x.falloff = v; })} />
        <MiniNum label="alcance" value={c.reach} onChange={(v) => set((x) => { x.reach = v; })} />
        <MiniNum label="scat" value={c.scattering} onChange={(v) => set((x) => { x.scattering = v; })} />
        <MiniNum label="pulse" value={c.pulse} onChange={(v) => set((x) => { x.pulse = v; })} />
        <MiniNum label="dir X" value={c.dirX} onChange={(v) => set((x) => { x.dirX = v; })} />
        <MiniNum label="dir Y" value={c.dirY} onChange={(v) => set((x) => { x.dirY = v; })} />
        <MiniNum label="dir Z" value={c.dirZ} onChange={(v) => set((x) => { x.dirZ = v; })} />
        <MiniNum label="cone" value={c.cone} onChange={(v) => set((x) => { x.cone = v; })} />
      </div>
      <label className="mt-1.5 flex items-center gap-2 text-[10px] text-muted">
        cor da emissão
