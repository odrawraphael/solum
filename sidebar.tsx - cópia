function Inspector() {
  const doc = useSolum((s) => s.doc);
  const sel = doc.selected;
  if (sel.kind === "layer") {
    const info = layerInfluence(doc, sel.id);
    if (!info) return <p className="text-[11px] text-muted">Camada não encontrada.</p>;
    const twice = whatIfLayer(doc, sel.id, { absorption: info.layer.absorption * 2 });
    const half = whatIfLayer(doc, sel.id, { absorption: info.layer.absorption * 0.5 });
    return (
      <div className="rounded-md border border-line bg-panel-2 p-2 text-xs">
        <div className="mb-1 font-display text-sm text-accent">{info.layer.name}</div>
        <dl className="grid grid-cols-[1fr_auto] gap-x-3 gap-y-0.5 font-mono text-[11px]">
          <dt className="text-muted">Papel</dt><dd>{LAYER_ROLE_LABELS[info.layer.role]}</dd>
          <dt className="text-muted">Forma</dt><dd>{SHAPES[info.layer.shape]}</dd>
          <dt className="text-muted">Raio</dt><dd>{info.layer.radius.toFixed(3)}</dd>
          <dt className="text-muted">Espessura</dt><dd>{info.layer.thickness.toFixed(3)}</dd>
          <dt className="text-muted">Densidade</dt><dd>{info.step.rho.toFixed(2)}</dd>
          <dt className="text-muted">Absorção</dt><dd>{info.step.absorb.toFixed(2)}</dd>
          <dt className="text-muted">Scatter</dt><dd>{info.step.scatter.toFixed(2)}</dd>
          <dt className="text-muted">τ</dt><dd>{info.step.tau.toFixed(2)}</dd>
          <dt className="text-muted">Passa</dt><dd>{(info.step.pass * 100).toFixed(1)}%</dd>
          <dt className="text-muted">Acumulado</dt><dd>{(info.step.cum * 100).toFixed(1)}%</dd>
          <dt className="text-muted">Emissão própria</dt><dd>{info.layer.emission.toFixed(2)}</dd>
        </dl>
        {twice && half ? (
          <p className="mt-2 text-[11px] text-muted">
            Se absorção ×2, T saída {(twice.next * 100).toFixed(0)}% ({twice.delta >= 0 ? "+" : ""}{(twice.delta * 100).toFixed(0)} pp).
            Se ÷2, {(half.next * 100).toFixed(0)}%.
          </p>
        ) : null}
        <div className="mt-2 text-[11px] text-muted">Influência das fontes nesta camada</div>
        {info.influences.map((x) => (
          <div key={x.name} className="flex justify-between font-mono text-[11px]">
            <span>{x.name} <span className="text-muted">({x.kind})</span></span>
            <span>{x.contribution.toFixed(2)}</span>
          </div>
        ))}
      </div>
    );
  }
  if (sel.kind === "source") {
    const info = sourceThroughLayers(doc, sel.id);
    if (!info) return null;
    return (
      <div className="rounded-md border border-line bg-panel-2 p-2 text-xs">
        <div className="mb-1 font-display text-sm text-accent">{info.source.name}</div>
        <p className="text-[11px] text-muted">
          Emissão na origem {info.power.toFixed(2)} → após as camadas {info.remaining.toFixed(2)} ({(info.remaining / Math.max(0.001, info.power) * 100).toFixed(0)}% chega à superfície).
          Cor {info.source.color}. Cone {info.source.cone.toFixed(2)} {info.source.cone < 0.01 ? "(omni)" : "(direcional)"}.
        </p>
        {info.steps.map((st, i) => (
          <div key={st.layer.id} className="flex justify-between font-mono text-[11px]">
            <span>L{i + 1} {st.layer.name}</span>
            <span>resta {(st.cum * 100).toFixed(0)}%</span>
          </div>
        ))}
      </div>
    );
  }
  return (
    <div className="rounded-md border border-line bg-panel-2 p-2 text-[11px] text-muted">
      <p className="mb-1.5">Clique numa camada, fonte, ou no preview para inspecionar o interior.</p>
      {describeCause(doc).map((l) => (
        <p key={l} className="mb-1">{l}</p>
      ))}
    </div>
  );
}
