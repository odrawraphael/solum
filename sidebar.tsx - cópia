function LayersEditor() {
  const doc = useSolum((s) => s.doc);
  const patch = useSolum((s) => s.patch);
  return (
    <div>
      <div className="mb-1.5 flex items-center justify-between">
        <span className="text-sm font-medium">Camadas</span>
        <Button
          size="sm"
          onClick={() =>
            patch((s) => {
              const last = s.layers.at(-1);
              const layer = DEFAULT_LAYER({
                id: newId("l"),
                name: `L${s.layers.length + 1} · nova`,
                radius: Math.max(0.12, (last?.radius ?? 1) - 0.22),
                thickness: 0.2,
                density: 0.6,
              });
              s.layers.push(layer);
              s.selected = { kind: "layer", id: layer.id };
            }, "Camada adicionada")
          }
        >
          + camada
        </Button>
      </div>
      {doc.layers.map((l, i) => (
        <LayerCard key={l.id} layer={l} index={i} />
      ))}
    </div>
  );
}

function LayerCard({ layer: l, index: i }: { layer: Layer; index: number }) {
  const sel = useSolum((s) => s.doc.selected);
  const patch = useSolum((s) => s.patch);
  const selected = sel.kind === "layer" && sel.id === l.id;
  const set = (fn: (x: Layer) => void, msg?: string) =>
    patch((s) => {
      const x = s.layers.find((n) => n.id === l.id);
      if (x) fn(x);
    }, msg);
  return (
    <FieldCard selected={selected} onClick={() => patch((s) => { s.selected = { kind: "layer", id: l.id }; })}>
      <div className="flex items-center justify-between gap-2">
        <strong className="text-xs">{l.name}</strong>
        <small className="text-muted">r {l.radius.toFixed(2)} · t {l.thickness.toFixed(2)}</small>
        <Button
          size="sm"
          variant="danger"
          onClick={(e) => {
            e.stopPropagation();
            patch((s) => {
              s.layers = s.layers.filter((n) => n.id !== l.id);
              s.selected = { kind: "object", id: "" };
            }, "Camada removida");
          }}
        >
          ×
        </Button>
      </div>
      <input
        value={l.name}
        onChange={(e) => set((x) => { x.name = e.target.value; })}
        className="mt-1.5 h-7 w-full rounded-sm border border-line bg-bg px-1.5 text-xs"
      />
      <div className="mt-1.5 grid grid-cols-4 gap-1.5">
        <MiniNum label="raio" value={l.radius} onChange={(v) => set((x) => { x.radius = v; })} />
        <MiniNum label="esp" value={l.thickness} onChange={(v) => set((x) => { x.thickness = v; })} />
        <MiniNum label="dens" value={l.density} onChange={(v) => set((x) => { x.density = v; })} />
        <MiniNum label="temp" value={l.temperature} onChange={(v) => set((x) => { x.temperature = v; })} />
        <MiniNum label="emit" value={l.emission} onChange={(v) => set((x) => { x.emission = v; })} />
        <MiniNum label="abs" value={l.absorption} onChange={(v) => set((x) => { x.absorption = v; })} />
        <MiniNum label="scat" value={l.scattering} onChange={(v) => set((x) => { x.scattering = v; })} />
        <MiniNum label="transm" value={l.transmission} onChange={(v) => set((x) => { x.transmission = v; })} />
      </div>
      <div className="mt-1.5 grid grid-cols-2 gap-1.5">
        <select
          value={l.role}
          onChange={(e) => set((x) => { x.role = e.target.value as LayerRole; }, `Papel L${i + 1}`)}
          className="h-7 w-full rounded-sm border border-line bg-bg px-1 text-xs"
        >
          {LAYER_ROLES.map((r) => (
            <option key={r} value={r}>{LAYER_ROLE_LABELS[r]}</option>
          ))}
        </select>
        <select
          value={l.shape}
          onChange={(e) => set((x) => { x.shape = Number(e.target.value); }, `Forma L${i + 1}`)}
          className="h-7 w-full rounded-sm border border-line bg-bg px-1 text-xs"
        >
          {SHAPES.map((n, j) => (
            <option key={n} value={j}>{n}</option>
          ))}
        </select>
      </div>
      <label className="mt-1.5 flex items-center gap-2 text-[10px] text-muted">
        tinta da camada
        <input
          type="color"
          value={l.tint || "#c45a28"}
          onChange={(e) => set((x) => { x.tint = e.target.value; })}
          className="h-7 w-9 cursor-pointer rounded-sm border border-line bg-transparent p-0.5"
        />
      </label>
    </FieldCard>
  );
